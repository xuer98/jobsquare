{
  "name": "gongzuo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gongzuo — auto-fill job applications from your saved profile.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "test": "esbuild scripts/test-matcher.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gongzuo-test.mjs && node node_modules/.cache/gongzuo-test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
